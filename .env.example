# Copy to .env and fill in. Values here are placeholders, never real secrets.
ENV=dev
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000"]

# Local runs outside Docker (docker-compose overrides these for its containers)
DATABASE_URL=postgresql+asyncpg://syllabus:syllabus@localhost:5432/syllabus
MONGO_URL=mongodb://localhost:27017
MONGO_DB=syllabus
REDIS_URL=redis://localhost:6379/0
FILES_ROOT=./var/files
TMP_ROOT=./var/tmp
# true: run checks inside the API process instead of Celery (quick local runs only)
TASKS_EAGER=false

# stub: files go to DRIVE_STUB_ROOT, refused when ENV=prod. google: see app/storage/drive.py.
DRIVE_PROVIDER=stub
DRIVE_STUB_ROOT=./var/drive
# Used for versions whose folder has no drive_folder_id
DRIVE_DEFAULT_FOLDER_ID=
# true: read Drive (the syllabus catalog) but never write to it; new versions wait locally
DRIVE_READ_ONLY=false
# DRIVE_PROVIDER=google: service account key or OAuth authorized-user file, put in ./secrets.
# Step by step: GOOGLE_DRIVE_SETUP.md. Check with: python -m app.cli drive-check
# GOOGLE_CREDENTIALS_FILE=/secrets/google-drive.json
# Service account only: act as this Workspace user (domain-wide delegation); empty = upload into Shared Drives only
# GOOGLE_IMPERSONATE_USER=
# Or connect Drive on the Schools & Drive screen (Provost Office): the uploaded key is kept here, mode 600.
# Settings saved there take precedence over the DRIVE_* / GOOGLE_* values above.
SECRETS_ROOT=./var/secrets
# How often celery beat re-reads the Schools' Drive folders (syllabus catalog), with Google Drive
DRIVE_SYNC_INTERVAL_S=900

# Docker only. DB_NAME=syllabus_real keeps the databases with real syllabi from Drive apart
# from the demo databases; /drive-local is ./drive-local, a downloaded copy of the Drive folder.
# DB_NAME=syllabus_real
# DRIVE_STUB_ROOT_IN_DOCKER=/drive-local

# stub: the bearer token is `stub:<email>`, refused when ENV=prod. google: Google Workspace sign-in.
# http: an external auth microservice. password: email + password only (needs JWT_SECRET).
AUTH_PROVIDER=stub
# true: at every `docker compose up` the migrate service creates the 4 Schools, the rubric and the test users
# of every role (superadmin@, provost@, kok@, admin.<school>@, head.<school>@, karimova@ on demo.narxoz.kz).
# Idempotent. With ENV=prod only together with TEST_USERS_PASSWORD (at least 8 characters).
SEED_TEST_USERS=false
TEST_USERS_PASSWORD=
# true: email + password sign-in next to Google (AUTH_PROVIDER=google), e.g. for test users.
# Passwords: python -m app.cli set-password EMAIL, or add-test-users --password
PASSWORD_LOGIN=false
# AUTH_PROVIDER=google: OAuth client "Web application" in Google Cloud. Authorized redirect URIs:
#   https://syllabus-agent.narxoz.kz/api/v1/auth/google/callback and http://localhost:8080/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_DOMAIN=narxoz.kz
# Empty: derived from the request. In production: https://syllabus-agent.narxoz.kz/api/v1/auth/google/callback
AUTH_REDIRECT_URL=
# Signs the session cookie: at least 32 random characters, e.g. `openssl rand -hex 32`
JWT_SECRET=
SESSION_TTL_HOURS=12
# false only for http://localhost
COOKIE_SECURE=true
# The contract HttpAuthClient expects is described in app/auth/client.py
AUTH_SERVICE_URL=
AUTH_SERVICE_VERIFY_PATH=/verify
AUTH_SERVICE_TIMEOUT_S=5

# fake: deterministic heuristics, no GPU needed. vllm / llamacpp (llama-server) / ollama: real model.
# openrouter: hosted models. LLM_BASE_URL=https://openrouter.ai/api/v1, LLM_API_KEY=sk-or-..., LLM_MODEL=qwen/qwen-2.5-72b-instruct
# (a model whose page lists structured outputs). Syllabus text is then sent to OpenRouter and the model's host.
LLM_PROVIDER=fake
# false switches off the model's reasoning before the answer (Qwen3 etc.), which keeps checks within the timeout.
LLM_THINKING=false
LLM_BASE_URL=http://host.docker.internal:8000/v1
LLM_API_KEY=EMPTY
LLM_MODEL=Qwen/Qwen2.5-32B-Instruct
LLM_MODEL_VERSION=vllm-qwen2.5-32b
LLM_MAX_CONCURRENCY=4
LLM_OUTPUT_LANGUAGE=English
# OpenRouter key (https://openrouter.ai/settings/keys). LLM_PROVIDER=openrouter uses it when LLM_API_KEY is EMPTY.
OPENROUTER_API_KEY=
# Decision model on OpenRouter, e.g. google/gemini-decision-1: gives every criterion its status in one request
# (about a second), and the chat model above only writes evidence, explanation and recommendation for the
# criteria that are not Compliant. Empty: the chat model decides every status, one request per principle.
# Example: LLM_PROVIDER=openrouter, LLM_BASE_URL=https://openrouter.ai/api/v1, LLM_MODEL=google/gemma-4-31b-it,
# DECISION_MODEL=google/gemini-decision-1 (about $0.40-0.80 per 146 syllabi at Nov 2026 prices).
DECISION_MODEL=
# ollama only: context the model is loaded with. Without it Ollama may use the model's maximum (262k for Qwen3),
# which spills onto the CPU and makes each request several times slower.
LLM_NUM_CTX=16384
LLM_KEEP_ALIVE=30m
# First guess for the time-left estimate (seconds per criteria request) until real checks have been timed
ETA_INITIAL_CALL_S=45

# console: log emails instead of sending
EMAIL_BACKEND=console
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=syllabus-ai@narxoz.kz
